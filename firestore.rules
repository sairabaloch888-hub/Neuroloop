rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /habits/{habitId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.anchor is string
          && request.resource.data.anchor.size() <= 200
          && request.resource.data.microAction is string
          && request.resource.data.microAction.size() <= 200
          && request.resource.data.maintenanceAction is string
          && request.resource.data.maintenanceAction.size() <= 200;

        match /logs/{dayKey} {
          allow read, write: if isOwner(uid);
        }
      }

      match /energy/{dayKey} {
        allow read, write: if isOwner(uid);
      }
    }
  }
}
